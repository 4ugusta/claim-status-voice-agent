# LiveKit Cloud (cloud.livekit.io): the only required account. Speech to text, the language model and
# text to speech all run through LiveKit Inference with these credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Real phone calls only (not needed for --loopback). scripts/setup_telephony.py creates the trunk and prints
# its id.
SIP_OUTBOUND_TRUNK_ID=

# Bonus: someone to bring onto the call when the agent gets stuck, E.164. Empty: the agent hangs up and
# logs that a person is needed.
HANDOFF_PHONE_NUMBER=

# Optional model overrides (LiveKit Inference model strings).
# CLAIMCALL_STT=deepgram/nova-3
# CLAIMCALL_LLM=openai/gpt-4.1-mini
